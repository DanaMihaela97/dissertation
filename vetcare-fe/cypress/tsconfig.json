{
  "compilerOptions": {
    "strict": true,
    "target": "es2015",
    "module": "commonjs",
    "lib": ["es2015", "dom"],
    "types": ["cypress", "node"],
    "esModuleInterop": true,
    "moduleResolution": "node"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "cypress/**/*.ts",
    "../node_modules/cypress/types/mocha/index.d.ts",
    "../node_modules/cypress/types/cypress-expect.d.ts"
  ]
}
